{
  "Serilog": {
  "MinimumLevel": {
    "Default": "Information",
    "Override": {
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "WriteTo": [
    { "Name": "Console" },
    {
      "Name": "File",
      "Args": { "path": "logs/log-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
    }
  ]
},
"Jwt": {
  "Issuer": "MonitoringDashboard",
  "Audience": "MonitoringDashboard.Client",
  "AccessTokenMinutes": 15,
  "RefreshTokenDays": 7
},
"Monitoring": {
  "CollectionIntervalMinutes": 2
},
"Cors": {
  "AllowedOrigins": [ "http://localhost:5173" ]
},
"Reports": { "StoragePath": "App_Data/reports" },
"OpenApi": { "Enabled": true },
"RateLimiting": { "AuthPermitPerMinute": 10 },
  "AllowedHosts": "*"
}
